+# Global switch to enable or disable all events
+# Set to 'true' to enable the event system, 'false' to disable it completely
+# When disabled, no events will occur and all multipliers will default to 1.0
+spawner-events-enabled: true
+
+# Check interval for starting new events (in seconds)
+# This determines how often the system checks if a new event should start
+# Lower values make checks more frequent but may impact performance
+# Higher values reduce checks but may lead to longer periods without events
+check-interval: 300 # 5 minutes
+
+# Chance to trigger an event when no events are active (0.0 to 1.0)
+# This is checked at each interval defined by 'check-interval'
+# 0.0 means events will never start automatically
+# 1.0 means an event will always start if none are active
+# 0.5 gives a 50% chance of an event starting at each check
+trigger-chance: 0.5
+
+# If true, there will always be an active event
+# When one event ends, another will immediately start
+# This overrides the 'trigger-chance' setting
+# Use with caution as it may lead to event fatigue for players
+always-active: false
+
+# Maximum number of concurrent events
+# Set to 1 to disable event stacking
+# Higher values allow multiple events to run simultaneously
+max-concurrent-events: 1
+
+# Global message settings
+global-messages:
+  # Set to true to use global messages instead of event-specific ones
+  # This allows for consistent messaging across all events
+  use-global-messages: false
+
+  # Message displayed when any event starts
